---
layout: base.njk
---
{% macro tocList(items) %}
<ol>
  {% for item in items %}
  <li>
    <a href="#{{ item.id }}">{{ item.text | safe }}</a>
    {% if item.children.length %}{{ tocList(item.children) }}{% endif %}
  </li>
  {% endfor %}
</ol>
{% endmacro %}
{% set toc = content | toc %}
<article>
  <h1>{{ title }}</h1>
  <p class="meta">
    <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
    {% for tag in tags %}<a class="tag" href="/tags/{{ tag | urlencode }}/">{{ tag }}</a>{% endfor %}
  </p>
  {% if toc.count > 1 %}
  <details class="toc" open>
    <summary>목차</summary>
    {{ tocList(toc.items) }}
  </details>
  {% endif %}
  {{ content | safe }}
  {% if relatedPost %}
    {% set related = collections.posts | findPost(relatedPost) %}
    <p class="related">👉 Related post: <a href="/posts/{{ relatedPost }}/">{{ related.data.title if related else relatedPost }}</a></p>
  {% endif %}
</article>
